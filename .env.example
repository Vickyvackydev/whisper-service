# ==============================================================================
# Whisper Asynchronous Transcription Service Configuration
# ==============================================================================

# Server
PORT=8080
ENVIRONMENT=production

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whisper_service?sslmode=disable

# Authentication
AUTH_ENABLED=true
API_TOKENS=dev-secret-token-change-in-production,secondary-token-example

# Worker Identification & ML Configuration
WORKER_ID=gpu-worker-node-1
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_CPU_THREADS=4

# HuggingFace Token (Required for pyannote.audio speaker diarization 3.1)
# Accept user conditions on huggingface.co/pyannote/speaker-diarization-3.1 and huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=your_huggingface_token_here
ENABLE_DIARIZATION=true

# Queue & Retry Policy
MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=1800
WATCHDOG_INTERVAL_SECONDS=10
STALE_JOB_THRESHOLD_SECONDS=45

# Webhook Settings
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=15

# Audio Safety Limits
MAX_AUDIO_SIZE_BYTES=2147483648
MAX_AUDIO_DURATION_SECONDS=14400
